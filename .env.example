# OpenAI-compatible provider
AI_BASE_URL=http://127.0.0.1:4100/v1
AI_API_KEY=
AI_MODEL=
AI_EMBEDDING_MODEL=
AI_EMBEDDINGS_ENABLED=false
# Optional dedicated embedding provider (unused when embeddings are disabled)
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# CLUSTER_DEBUG=true

# Optional aliases
# BUYTOKENS_API_KEY=
# BUYTOKENS_BASE_URL=
# BUYTOKENS_MODEL=

# Production Postgres. If unset, local PGlite is used.
DATABASE_URL=

# PGlite file directory (dev / CI)
PGLITE_DATA_DIR=./data/dispatch

# Public site
SITE_URL=http://localhost:3002
SITE_NAME=Dispatch
